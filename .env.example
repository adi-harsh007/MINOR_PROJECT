# API Configuration
PORT=8088
HOST=0.0.0.0

# Database Configuration
# DATABASE_URL=sqlite:///./data/pathology.db

# Model Paths (Relative to project root or absolute)
# MODEL_PATH=models/latest.pt
# THRESHOLD_PATH=models/class_thresholds.json

# ── Security ────────────────────────────────────────────────
# Comma-separated browser origins allowed to call the API.
# Defaults to local dev only. Never use "*" — this API handles clinical images.
# CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088

# Required by the destructive endpoints (DELETE /api/history/*), sent as the
# X-Admin-Token header. When unset, those endpoints return 403 and are disabled.
# ADMIN_TOKEN=

# Maximum accepted upload size in bytes (default 10 MB).
# MAX_UPLOAD_BYTES=10485760
